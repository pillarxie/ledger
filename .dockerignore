# 依赖与产物（镜像内会重新安装/构建，绝不能把宿主机 node_modules 带进去）
node_modules
.pnpm-store
dist
coverage
*.tsbuildinfo

# 环境变量（密钥通过 env_file 注入，不要打进镜像）
.env
.env.*
!.env.example
!.env.nas.example

# 本地数据与上传文件
data
uploads

# 版本控制 / 编辑器 / 系统文件
.git
.gitignore
.github
.vscode
.idea
.DS_Store
*.log

# 文档与测试（运行镜像不需要）
docs
test
