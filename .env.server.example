# 服务器部署配置模板
#
#   cp .env.server.example .env
#   # 改掉下面两个 CHANGE_ME，然后 up -d --build
#
# 这个文件同时被两处使用：
#   1) docker compose 读取，用于 YAML 里的 ${变量} 替换
#   2) 作为 env_file 注入 api 容器

# ---------- 必改 ----------

# 数据库密码：随便一串强密码
POSTGRES_PASSWORD=CHANGE_ME_db_password

# JWT 签名密钥：openssl rand -hex 32
# 公网上这个泄露 = 任何人都能伪造登录态，务必换掉
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---------- 访问方式（二选一）----------

# 走域名 + HTTPS（推荐）：保持 127.0.0.1，
# 然后在宝塔「网站 → 反向代理」里指向 http://127.0.0.1:3002
API_BIND=127.0.0.1

# 图省事、先用 IP 直连：改成 0.0.0.0，之后访问 http://服务器IP:3002/api
# （注意云厂商安全组要放行 3002；没有 HTTPS）
# API_BIND=0.0.0.0

API_PORT=3002

# ---------- 一般不用改 ----------

POSTGRES_USER=ledger
POSTGRES_DB=ledger_db

# 数据存放目录，相对路径相对于本项目目录
DATA_DIR=./data

JWT_ACCESS_TOKEN_EXPIRES_IN=900
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
INVITE_CODE_LENGTH=6
INVITE_CODE_EXPIRES_DAYS=7

RUN_MIGRATIONS=true

# 公网上建议关掉接口文档（/api/docs 会暴露全部接口定义）
# 调试时临时改成 true 即可
SWAGGER_ENABLED=false
