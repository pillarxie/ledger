# 飞牛 OS 部署配置模板
#
# 用法：
#   cp .env.nas.example .env       # 在 NAS 上执行
#   # 然后按下面说明修改，至少改掉 POSTGRES_PASSWORD 和 JWT_SECRET
#
# 注意：这个文件同时被两处使用
#   1) docker compose 读取，用于 YAML 里的 ${变量} 替换
#   2) 作为 env_file 注入 api 容器

# ---------- 必改项 ----------

# 数据库密码：自己生成一个强密码
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# JWT 签名密钥：必须换成随机值，泄露等于任何人都能伪造登录态
# 生成方式：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---------- 可选调整 ----------

# 数据库名与用户名（一般不用改）
POSTGRES_USER=ledger
POSTGRES_DB=ledger_db

# API 在 NAS 上对外开放的端口（前端 app 就填这个端口）
API_PORT=3000

# 数据存放目录。相对路径是相对于本 compose 文件所在目录；
# 想放到 NAS 卷上就写绝对路径，例如 /vol1/1000/docker/ledger
DATA_DIR=./data

# ---------- 业务参数（沿用开发默认值即可） ----------

# access token 有效期（秒），900 = 15 分钟
JWT_ACCESS_TOKEN_EXPIRES_IN=900
# refresh token 有效期（秒），604800 = 7 天
JWT_REFRESH_TOKEN_EXPIRES_IN=604800

# 邀请码
INVITE_CODE_LENGTH=6
INVITE_CODE_EXPIRES_DAYS=7

# 是否在容器启动时自动执行 prisma migrate deploy
RUN_MIGRATIONS=true
